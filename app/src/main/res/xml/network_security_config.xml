<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Yalnizca HTTPS: tum trafik sifrelenir, aciktan (http) baglantiya izin verilmez. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
